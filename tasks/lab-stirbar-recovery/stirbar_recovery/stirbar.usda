#usda 1.0
(
    defaultPrim = "Part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (1.8375e-8, 1.654375e-7, 1.654375e-7)
    float physics:mass = 0.003
    custom bool physxRigidBody:enableCCD = 1
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cylinder "bar" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.025
        color3f[] primvars:displayColor = [(0.96, 0.96, 0.93)]
        double radius = 0.0035
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "mark"
    {
        uniform token axis = "X"
        double height = 0.002
        color3f[] primvars:displayColor = [(0.07, 0.35, 0.7)]
        double radius = 0.00355
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

