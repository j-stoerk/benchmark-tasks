#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
{
    bool physics:rigidBodyEnabled = true
    float physics:mass = 0.085
    def Cylinder "Shaft" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"])
    {
        uniform token axis = "Y"
        double height = 0.24
        double radius = 0.009
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.05, 0.25, 0.85)]
    }
    def Cube "Grip_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, -0.1, 0)
        double3 xformOp:scale = (0.024, 0.03, 0.024)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.05, 0.25, 0.85)]
    }
    def Cube "Grip_1" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0.1, 0)
        double3 xformOp:scale = (0.024, 0.03, 0.024)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.05, 0.25, 0.85)]
    }
}
